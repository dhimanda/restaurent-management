# ===========================
# Electron JS .gitignore
# ===========================


# ---------------------------
# Dependencies
# ---------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/
package-lock.json
yarn.lock
pnpm-lock.yaml


# ---------------------------
# Build & Distribution Output
# ---------------------------
dist/
dist-electron/
out/
build/
release/
output/
app/dist/
renderer/dist/
.webpack/
.vite/


# ---------------------------
# Electron Builder / Packager
# ---------------------------
# Installer artifacts
*.exe
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage
*.snap
*.flatpak
*.msi
*.nsis
*.zip
*.tar.gz
*.tar.bz2

# Auto-updater release files
*.blockmap
latest.yml
latest-mac.yml
latest-linux.yml


# ---------------------------
# Electron Cache & Temp
# ---------------------------
.electron/
electron-builder-cache/
__pycache__/
.cache/
.tmp/
tmp/
temp/


# ---------------------------
# Environment & Secrets
# ---------------------------
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
secrets/
credentials/


# ---------------------------
# Logs
# ---------------------------
logs/
*.log
npm-debug.log
yarn-debug.log
electron-crash-report/
crash-reports/


# ---------------------------
# OS Generated Files
# ---------------------------

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*


# ---------------------------
# IDE & Editor
# ---------------------------

# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*.swn
Session.vim
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# Sublime Text
*.sublime-project
*.sublime-workspace


# ---------------------------
# TypeScript
# ---------------------------
*.tsbuildinfo
tsconfig.tsbuildinfo


# ---------------------------
# Testing
# ---------------------------
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
.playwright/


# ---------------------------
# Vite / Webpack / Rollup
# ---------------------------
.vite/
.rollup.cache
stats.html
stats.json


# ---------------------------
# Electron Forge
# ---------------------------
.webpack/
forge.config.js.bak


# ---------------------------
# Native Modules (node-gyp)
# ---------------------------
build/Release/
*.node
*.gyp
*.gypi


# ---------------------------
# Miscellaneous
# ---------------------------
.npmrc
.yarnrc
*.orig
*.bak
*.patch
CHANGELOG.md.bak